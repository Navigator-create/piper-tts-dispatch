#!/usr/bin/env bash
set -euo pipefail

PID_FILE="/tmp/tts-dispatch.pid"
LOG_FILE="/tmp/tts-dispatch.log"
PIPER_BIN="$HOME/.local/bin/piper"
VOICE_MODEL="$HOME/.local/share/piper_voices/en_US-amy-medium.onnx"

if [[ "${1:-}" == "--stop" ]]; then
    if [[ -f "$PID_FILE" ]]; then
        kill -9 "$(cat "$PID_FILE")" 2>/dev/null || true
        rm -f "$PID_FILE"
    fi
    pkill -9 aplay 2>/dev/null || true
    pkill -9 piper 2>/dev/null || true
    exit 0
fi

if [[ "${1:-}" == "--toggle-pause" ]]; then
    if [[ -f "$PID_FILE" ]]; then
        PID="$(cat "$PID_FILE")"
        if kill -0 "$PID" 2>/dev/null; then
            kill -STOP "$PID" 2>/dev/null || kill -CONT "$PID" 2>/dev/null
            exit 0
        fi
    fi
    exit 0
fi

if [[ -f "$PID_FILE" ]]; then
    kill -9 "$(cat "$PID_FILE")" 2>/dev/null || true
    rm -f "$PID_FILE"
fi

if [[ -n "${1:-}" ]]; then
    TEXT_CONTENT="$1"
else
    TEXT_CONTENT="$(xclip -o -selection clipboard 2>/dev/null || xsel -o -b 2>/dev/null || true)"
fi

if [[ -z "$TEXT_CONTENT" ]]; then
    exit 0
fi

CLEAN_TEXT=$(echo "$TEXT_CONTENT" \
    | sed -E 's|https?://[^ ]+||g' \
    | sed -E 's/[#\*_~`=+\/&<>]//g' \
    | sed -E 's/[-]{2,}/ /g' \
    | tr -s ' ')

echo $$ > "$PID_FILE"
trap 'rm -f "$PID_FILE"' EXIT

echo "$CLEAN_TEXT" | "$PIPER_BIN" --model "$VOICE_MODEL" --output_raw 2>>"$LOG_FILE" | aplay -r 22050 -f S16_LE -t raw 2>>"$LOG_FILE"
