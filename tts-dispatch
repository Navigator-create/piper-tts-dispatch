#!/usr/bin/env bash
set -euo pipefail

LOG_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/tts-dispatch.log"
PID_FILE="/tmp/tts-dispatch.pid"
mkdir -p "$(dirname "$LOG_FILE")"

log() {
    echo "[$(date -Iseconds)] [$1] $2" | tee -a "$LOG_FILE"
}

# 1. PROCESS CONTROL HANDLERS
stop_tts() {
    if [[ -f "$PID_FILE" ]]; then
        PID=$(cat "$PID_FILE" 2>/dev/null || true)
        if [[ -n "$PID" ]] && kill -0 "$PID" 2>/dev/null; then
            pkill -P "$PID" 2>/dev/null || true
            kill "$PID" 2>/dev/null || true
            log "INFO" "TTS playback stopped."
        fi
        rm -f "$PID_FILE"
    fi
    pkill -f "aplay.*raw" 2>/dev/null || true
    pkill -f "piper.*--output-raw" 2>/dev/null || true
}

pause_tts() {
    if command -v pkill >/dev/null 2>&1; then
        pkill -STOP -f "aplay.*raw" 2>/dev/null && log "INFO" "Audio paused." || log "WARN" "No active playback to pause."
    fi
}

resume_tts() {
    if command -v pkill >/dev/null 2>&1; then
        pkill -CONT -f "aplay.*raw" 2>/dev/null && log "INFO" "Audio resumed." || log "WARN" "No paused playback to resume."
    fi
}

# 2. CLI ARGUMENT ROUTING
case "${1:-}" in
    --stop)
        stop_tts
        exit 0
        ;;
    --pause)
        pause_tts
        exit 0
        ;;
    --resume)
        resume_tts
        exit 0
        ;;
    --toggle-pause)
        if pgrep -f "aplay.*raw" >/dev/null; then
            # If paused, resume; if running, pause
            if ps -o state= -p $(pgrep -f "aplay.*raw" | head -n1) | grep -q "T"; then
                resume_tts
            else
                pause_tts
            fi
        fi
        exit 0
        ;;
esac

# 3. TERMINATE EXISTING PLAYBACK BEFORE STARTING NEW TTS
stop_tts

# Save subshell PID for process control
echo "$$" > "$PID_FILE"

TEXT_CONTENT="${1:-$(xclip -o -selection clipboard 2>/dev/null || xsel -o -b 2>/dev/null || true)}"

if [[ -z "$TEXT_CONTENT" ]]; then
    log "ERROR" "No text provided or found in clipboard."
    rm -f "$PID_FILE"
    exit 1
fi

PIPER_BIN="$HOME/.local/bin/piper"
VOICE_MODEL="${PIPER_VOICE_MODEL:-$HOME/.local/share/piper-voices/en_US-ryan-high.onnx}"

if [[ ! -x "$PIPER_BIN" ]]; then
    log "ERROR" "Piper binary missing or not executable at: $PIPER_BIN"
    rm -f "$PID_FILE"
    exit 1
fi

if [[ ! -f "$VOICE_MODEL" ]]; then
    log "ERROR" "Voice model file missing at: $VOICE_MODEL"
    rm -f "$PID_FILE"
    exit 1
fi

log "INFO" "Executing Piper (Model: $(basename "$VOICE_MODEL"))"

cleanup() {
    rm -f "$PID_FILE"
}
trap cleanup EXIT

echo "$TEXT_CONTENT" | "$PIPER_BIN" --model "$VOICE_MODEL" --output-raw 2>>"$LOG_FILE" | aplay -r 22050 -f S16_LE -t raw - 2>>"$LOG_FILE"